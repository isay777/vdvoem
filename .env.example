# Mobile public configuration. The publishable key is intentionally safe for a client;
# all authorization is enforced by PostgreSQL RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_INVITE_BASE_URL=https://bar.smuzi-studio.ru
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_DEMO_MODE=false

# Invite web (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_APP_SCHEME=myvdvoem
VITE_APP_STORE_URL=https://apps.apple.com/app/id0000000000
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.myvdvoem.mobile

# Server-only values must be configured with `supabase secrets set`, never EXPO_PUBLIC_*.
# EXPO_ACCESS_TOKEN=
# INVITE_FINGERPRINT_PEPPER=
# ACCOUNT_DELETION_CRON_SECRET=
