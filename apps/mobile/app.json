{
  "expo": {
    "name": "Мы вдвоём",
    "slug": "my-vdvoem",
    "description": "Приватное пространство пары для желаний, планов, свиданий и повседневных дел.",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "myvdvoem",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.myvdvoem.mobile",
      "associatedDomains": ["applinks:bar.smuzi-studio.ru"],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Чтобы добавить фотографию к желанию или идее свидания.",
        "NSCameraUsageDescription": "Чтобы сделать фотографию для вашей общей записи."
      }
    },
    "android": {
      "package": "app.myvdvoem.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F3"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "bar.smuzi-studio.ru", "pathPrefix": "/invite" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      ["expo-image-picker", { "photosPermission": "Разрешите выбрать фото для вашей общей записи.", "cameraPermission": "Разрешите сделать фото для вашей общей записи.", "microphonePermission": false }],
      ["expo-notifications", { "color": "#E7688D", "defaultChannel": "updates" }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "eas": { "projectId": "bf59090f-3d37-406b-808f-9a4ee976e051" }
    }
  }
}
